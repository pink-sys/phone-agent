<?xml version="1.0" encoding="utf-8"?>
<!--
  注意：这里故意不写 package 属性。
  Gradle 8 + AGP 8 用 build.gradle.kts 里的 namespace 指定包名；
  手工构建脚本会在打包前把 package="cn.wbphone.agent" 注入到临时副本里。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 审批闸门要能在你切走 App 时提醒你：付款这类动作不会一直在前台等着 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
        语音输入必须由调用方持有 RECORD_AUDIO。
        别被「录音在识别服务里」骗了：SpeechRecognizer 校验的是**调用 App** 的权限，
        没有这条，任何设备的识别都会直接返回 ERROR_INSUFFICIENT_PERMISSIONS。
        运行时只在点 🎤 时申请，不占启动流程。
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 常驻一条低优先级通知，让进程有前台身份，不容易被系统连无障碍一起回收 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
        自动恢复无障碍用。普通安装拿不到这条（development 级），
        需要用户用一条 adb 命令授予一次；没授权时相关代码全部空转。
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- 重启后把常驻服务和无障碍补回来 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        悬浮状态窗：任务切到别的应用上时，小胶囊浮着告诉你它在干什么。
        TYPE_APPLICATION_OVERLAY 需要用户在设置里点一次「显示在应用上层」。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        Android 11+ 包可见性：不声明这条，PackageManager 默认看不见其他应用，
        phone_launch_app 会对所有第三方应用报「找不到包」。
        声明「带桌面入口的应用」这一类就够，不用 QUERY_ALL_PACKAGES 那条受限权限。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!--
            TTS 引擎可见性：朗读用系统 TTS，Android 11+ 上不声明就看不见引擎。
            （语音输入已改走讯飞听写 API，不再依赖系统 RecognitionService。）
        -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_agent"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PhoneAccessibilityService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            stopWithTask=false：从最近任务划掉时不销毁服务。
            有些 ROM 划掉任务等于强制停止，那种情况这条也拦不住，只能靠用户别划。
        -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="保持无障碍服务在线，避免被系统回收后无法操作手机" />
        </service>

        <!--
            产物分享：把工作台文件以 content:// 提供给其他应用（WPS、浏览器）。
            只读、沙箱内、canonical 前缀校验，见 ArtifactProvider。
        -->
        <provider
            android:name=".ArtifactProvider"
            android:authorities="cn.wbphone.agent.artifacts"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!--
            拍照临时文件：相机要一个可写的 content:// 当输出位置。
            只管 cache/attach 一个目录、只给相机一次性授权，见 DraftProvider。
        -->
        <provider
            android:name=".DraftProvider"
            android:authorities="cn.wbphone.agent.drafts"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 开机 / 升级后补一次：把常驻服务拉起来，需要时把无障碍开关写回去 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
